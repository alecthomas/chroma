# Everything after "#" is a comment.
# A file is a class!

# (optional) icon to show in the editor dialogs:
@icon("res://path/to/optional/icon.svg")

# (optional) class definition:
class_name MyClass

# Inheritance:
extends BaseClass


# Member variables.
var a = 5
var s = "Hello"
var arr = [1, 2, 3]
var dict = {"key": "value", 2: 3}
var other_dict = {key = "value", other_key = 2}
var typed_var: int
var inferred_type := "String"

# Constants.
const ANSWER = 42
const THE_NAME = "Charly"

# Enums.
enum {UNIT_NEUTRAL, UNIT_ENEMY, UNIT_ALLY}
enum Named {THING_1, THING_2, ANOTHER_THING = -1}

# Built-in vector types.
var v2 = Vector2(1, 2)
var v3 = Vector3(1, 2, 3)


# Functions.
func some_function(param1, param2, param3):
    const local_const = 5

    if param1 < local_const:
        print(param1)
    elif param2 > 5:
        print(param2)
    else:
        print("Fail!")

    for i in range(20):
        print(i)

    while param2 != 0:
        param2 -= 1

    match param3:
        3:
            print("param3 is 3!")
        _:
            print("param3 is not 3!")

    var local_var = param1 + 3
    return local_var


# Functions override functions with the same name on the base/super class.
# If you still want to call them, use "super":
func something(p1, p2):
    super(p1, p2)


# It's also possible to call another function in the super class:
func other_something(p1, p2):
    super.something(p1, p2)


# Inner class
class Something:
    var a = 10


# Constructor
func _init():
    print("Constructed!")
    var lv = Something.new()
    print(lv.a)


## Documentation comments start with two hashes.
## They may contain BBCode such as [b]bold[/b] and [method some_function].
## @deprecated: Use [method some_function] instead.
func documented() -> void:
    pass


class Exports:
    @export_storage var stored := 0
    @export_custom(PROPERTY_HINT_NONE, "suffix:m") var custom := 0.0
    @export_tool_button("Bake") var bake: Callable
    @export_range(0, 100, 1, "or_greater") var ranged := 50
    @onready var lazy := Vector2.ZERO

    @warning_ignore_start("unused_variable")
    func noisy() -> void:
        var unused := 1
    @warning_ignore_restore("unused_variable")


@abstract
class Shape:
    @abstract
    func area() -> float


var health := 100:
    get:
        return health
    set(value):
        health = clampi(value, 0, 100)

var referenced := 0:
    get = _get_referenced, set = _set_referenced


var doubler := func(x: int) -> int: return x * 2
var comparer := func(a, b): return a < b
var greeter := func(): print("hi")


var big := 1_000_000
var hex := 0xDEAD_BEEF
var upper_hex := 0XFF
var bits := 0b1010_1010
var upper_bits := 0B11
var fractional := 1_000.000_1
var trailing_point := 10.
var leading_point := .5
var exponent := 1_0e-1_0


var raw := r"C:\not\escaped\at\all"
var raw_regex := r'\d+(\.\d+)?'
var raw_multiline := r"""\w+"""
var string_name := &"my_signal"
var node_path := ^"Sprite2D:position"
var multiline := """
Spans
multiple lines
"""

var masked := 0b1100 & 0b1010
var xored := 0xF0 ^ 0x0F


func _enter_tree() -> void:
    var plain := $Sprite2D
    var nested := $Container/Label
    var quoted := $"Node With Spaces"
    var unique := %UniqueName
    var unique_quoted := %"Unique With Spaces"
    var nested_unique := $Container/%UniqueChild
    var modulo := 10 % 3


func classify(value: Variant) -> String:
    match value:
        var v when v is int and v < 0:
            return "negative"
        0:
            return "zero"
        [var first, ..]:
            return "array starting with %s" % first
        {"key": var found}:
            return "dictionary with %s" % found
        _:
            return "something else"


var typed_array: Array[int] = [1, 2, 3]
var typed_dict: Dictionary[String, int] = {"one": 1}

var rect_i := Rect2i(0, 0, 16, 16)
var projection := Projection()
var packed_v4 := PackedVector4Array()

