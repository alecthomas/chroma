  {"type":"GenericHeading","value":"Options"},
  {"type":"Punctuation","value":":"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"-f"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003cformatter\u003e"},
  {"type":"Text","value":"      "},
  {"type":"Comment","value":"Format to use (html, terminal, json, svg, png, jpeg, webp, highlights)"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"-t"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003ctheme\u003e"},
  {"type":"Text","value":"          "},
  {"type":"Comment","value":"Theme to use, see --list-themes "},
  {"type":"Punctuation","value":"["},
  {"type":"NameBuiltin","value":"default"},
  {"type":"Punctuation","value":": "},
  {"type":"LiteralString","value":"default-dark"},
  {"type":"Punctuation","value":"]"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--light"},
  {"type":"Text","value":"             "},
  {"type":"Comment","value":"Force light variant of the theme (if available)"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--dark"},
  {"type":"Text","value":"              "},
  {"type":"Comment","value":"Force dark variant of the theme (if available)"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"-l"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003clexer\u003e"},
  {"type":"Text","value":"          "},
  {"type":"Comment","value":"Lexer (language) to use, see --list-lexers. Use more than"},
  {"type":"Text","value":"\n                      "},
  {"type":"Comment","value":"one lexer with \"+\" (e.g. jinja+yaml) "},
  {"type":"Punctuation","value":"["},
  {"type":"NameBuiltin","value":"default"},
  {"type":"Punctuation","value":": "},
  {"type":"LiteralString","value":"autodetect"},
  {"type":"Punctuation","value":"]"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"-o"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003coutput\u003e"},
  {"type":"Text","value":"         "},
  {"type":"Comment","value":"Output file. Default is stdout."},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--standalone"},
  {"type":"Text","value":"        "},
  {"type":"Comment","value":"Generate a standalone HTML file, which includes"},
  {"type":"Text","value":"\n                      "},
  {"type":"Comment","value":"all style information. If not given, it will generate just"},
  {"type":"Text","value":"\n                      "},
  {"type":"Comment","value":"a HTML fragment ready to include in your own page."},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--css"},
  {"type":"Text","value":"               "},
  {"type":"Comment","value":"Generate a CSS file for the theme called \u003ctheme\u003e.css"},
  {"type":"Text","value":"\n                      "},
  {"type":"Comment","value":"(works with html and highlights formatters)"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--template"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003cfile\u003e"},
  {"type":"Text","value":"   "},
  {"type":"Comment","value":"Use a custom template for the HTML output "},
  {"type":"Punctuation","value":"["},
  {"type":"NameBuiltin","value":"default"},
  {"type":"Punctuation","value":": "},
  {"type":"LiteralString","value":"none"},
  {"type":"Punctuation","value":"]"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--line-numbers"},
  {"type":"Text","value":"      "},
  {"type":"Comment","value":"Include line numbers in the output"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--font-path"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003cpath\u003e"},
  {"type":"Text","value":"  "},
  {"type":"Comment","value":"Path to TrueType/OpenType font file (.ttf or .otf) for image output"},
  {"type":"Text","value":"\n                      "},
  {"type":"Comment","value":"(default: bundled JetBrains Mono)"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--font-size"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003csize\u003e"},
  {"type":"Text","value":"  "},
  {"type":"Comment","value":"Font point size for image output (e.g. 14) "},
  {"type":"Punctuation","value":"["},
  {"type":"NameBuiltin","value":"default"},
  {"type":"Punctuation","value":": "},
  {"type":"LiteralString","value":"14"},
  {"type":"Punctuation","value":"]"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--width"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003cw\u003e"},
  {"type":"Text","value":"         "},
  {"type":"Comment","value":"Maximum image width in pixels (0 = auto based on content) "},
  {"type":"Punctuation","value":"["},
  {"type":"NameBuiltin","value":"default"},
  {"type":"Punctuation","value":": "},
  {"type":"LiteralString","value":"0"},
  {"type":"Punctuation","value":"]"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--height"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003ch\u003e"},
  {"type":"Text","value":"        "},
  {"type":"Comment","value":"Maximum image height in pixels (0 = auto based on content) "},
  {"type":"Punctuation","value":"["},
  {"type":"NameBuiltin","value":"default"},
  {"type":"Punctuation","value":": "},
  {"type":"LiteralString","value":"0"},
  {"type":"Punctuation","value":"]"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--quality"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003cq\u003e"},
  {"type":"Text","value":"       "},
  {"type":"Comment","value":"JPEG/WebP quality (1-100, default: 90)"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--list-extensions"},
  {"type":"Text","value":" "},
  {"type":"NameVariable","value":"\u003clexer\u003e"},
  {"type":"Text","value":"  "},
  {"type":"Comment","value":"List file extensions for a lexer"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"--show-variants"},
  {"type":"Text","value":"    "},
  {"type":"Comment","value":"Show theme variant information in theme list"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"-h"},
  {"type":"Punctuation","value":","},
  {"type":"Text","value":" "},
  {"type":"NameAttribute","value":"--help"},
  {"type":"Text","value":"          "},
  {"type":"Comment","value":"Show this screen"},
  {"type":"Text","value":"\n  "},
  {"type":"NameAttribute","value":"-v"},
  {"type":"Punctuation","value":","},
  {"type":"Text","value":" "},
  {"type":"NameAttribute","value":"--version"},
  {"type":"Text","value":"       "},
  {"type":"Comment","value":"Show version number"},
  {"type":"Text","value":"\n"}
]
