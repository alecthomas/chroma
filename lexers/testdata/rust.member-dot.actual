trait Identity {
    fn _e2(self) -> Self;
    fn δ(self) -> Self;
}

impl Identity for i32 {
    fn _e2(self) -> Self { self }
    fn δ(self) -> Self { self }
}

impl Identity for f64 {
    fn _e2(self) -> Self { self }
    fn δ(self) -> Self { self }
}

fn main() {
    assert_eq!(1.max(2), 2);
    assert_eq!(1.to_string(), "1");
    assert_eq!(12_345._e2(), 12_345);
    assert_eq!(7.δ(), 7);
    assert_eq!(1.25._e2(), 1.25);
    assert_eq!(7.5.δ(), 7.5);
}
