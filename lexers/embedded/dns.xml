<?xml version="1.0"?>
<lexer>
  <config>
    <name>dns</name>
    <alias>zone</alias>
    <alias>bind</alias>
    <filename>*.zone</filename>
    <mime_type>text/dns</mime_type>
    <analyse first="true">
      <regex pattern="(?m)^@\s+IN\s+SOA\s+" score="1.0"/>
    </analyse>
  </config>
  <rules>
    <state name="root">
      <rule pattern="^\$(TTL|GENERATE|INCLUDE|ORIGIN)\b">
        <token type="NameAttribute"/>
      </rule>
      <rule pattern="&quot;(\\.|[^&quot;\\])*&quot;">
        <token type="LiteralStringDouble"/>
      </rule>
      <rule pattern=";[^\r\n]*">
        <token type="Comment"/>
      </rule>
      <rule words="IN CH HS A AAAA AFSDB APL CAA CDNSKEY CDS CERT CNAME CSYNC DHCID DLV DNAME DNSKEY DS HINFO HIP HTTPS IPSECKEY KEY KX LOC MX NAPTR NS NSEC NSEC3 NSEC3PARAM OPENPGPKEY PTR RP RRSIG SIG SMIMEA SOA SRV SSHFP SVCB TA TKEY TLSA TSIG TXT URI ZONEMD" prefix="(?&lt;=^|\s)" suffix="(?=\s|;|$|\))">
        <token type="Keyword"/>
      </rule>
      <rule pattern="(?&lt;=^|\s|=|,)((([0-9A-Fa-f]{1,4}:){7}([0-9A-Fa-f]{1,4}|:))|(([0-9A-Fa-f]{1,4}:){6}(:[0-9A-Fa-f]{1,4}|((25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)){3})|:))|(([0-9A-Fa-f]{1,4}:){5}(((:[0-9A-Fa-f]{1,4}){1,2})|:((25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)){3})|:))|(([0-9A-Fa-f]{1,4}:){4}(((:[0-9A-Fa-f]{1,4}){1,3})|((:[0-9A-Fa-f]{1,4})?:((25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){3}(((:[0-9A-Fa-f]{1,4}){1,4})|((:[0-9A-Fa-f]{1,4}){0,2}:((25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){2}(((:[0-9A-Fa-f]{1,4}){1,5})|((:[0-9A-Fa-f]{1,4}){0,3}:((25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){1}(((:[0-9A-Fa-f]{1,4}){1,6})|((:[0-9A-Fa-f]{1,4}){0,4}:((25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)){3}))|:))|(:(((:[0-9A-Fa-f]{1,4}){1,7})|((:[0-9A-Fa-f]{1,4}){0,5}:((25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d)){3}))|:)))(?=\s|;|$|\)|,)">
        <token type="LiteralNumberIntegerLong"/>
      </rule>
      <rule pattern="(?&lt;=^|\s|=|,)((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])(?=\s|;|$|\)|,)">
        <token type="LiteralNumberInteger"/>
      </rule>
      <rule pattern="(?&lt;=^|\s)([a-z0-9-]+)(=)">
        <bygroups>
          <token type="NameAttribute"/>
          <token type="Operator"/>
        </bygroups>
      </rule>
      <rule pattern="(?&lt;=^|\s|=|\()(?:\d+[smhdwSMHDW])+(?=\s|;|$|\)|,)|(?&lt;=^|\s|=|\()\d+(?=\s|;|$|\)|,)">
        <token type="LiteralStringChar"/>
      </rule>
      <rule pattern="(?&lt;=^|\s)\.(?=\s|;|$|\))">
        <token type="NameProperty"/>
      </rule>
      <rule pattern="(?:\*\.)?[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*\.(?=\s|;|$|\))">
        <token type="NameProperty"/>
      </rule>
      <rule pattern="(@|\*(?:\.[A-Za-z0-9_-]+)*|[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*)(?=\s|;|$|\))">
        <token type="NameClass"/>
      </rule>
      <rule pattern="[A-Za-z0-9+/=]+">
        <token type="LiteralString"/>
      </rule>
      <rule words="( ) ,">
        <token type="Punctuation"/>
      </rule>
      <rule pattern="[\r\n\s\t]+">
        <token type="TextWhitespace"/>
      </rule>
    </state>
  </rules>
</lexer>
