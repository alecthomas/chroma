<lexer>
  <config>
    <name>properties</name>
    <alias>java-properties</alias>
    <filename>*.properties</filename>
    <mime_type>text/x-java-properties</mime_type>
  </config>
  <rules>
    <state name="root">
      <rule pattern="[#!][^\r\n]*">
        <token type="CommentSingle"/>
      </rule>
      <rule pattern="[ \t\f\r\n]+|\\(?:\r\n?|\n)">
        <token type="Text"/>
      </rule>
      <rule pattern="(?:[^\\ \t\f\r\n:=]|\\(?:(?:\r\n?|\n)[ \t\f]*|.)?)+">
        <token type="NameAttribute"/>
        <push state="value"/>
      </rule>
      <rule pattern="(?=[=:])">
        <push state="value"/>
      </rule>
    </state>
    <state name="value">
      <rule pattern="((?:[ \t\f]|\\(?:\r\n?|\n))*)([=:]?)([ \t\f]*)((?:[^\\\r\n]+|\\(?:\r\n|[\s\S])?)*)">
        <bygroups>
          <token type="Text"/>
          <token type="Operator"/>
          <token type="Text"/>
          <token type="LiteralString"/>
        </bygroups>
        <pop depth="1"/>
      </rule>
    </state>
  </rules>
</lexer>
