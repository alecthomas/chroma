[values]
	true-name = yes
	also-true = on
	false-name = no
	also-false = off
	one = 1
	zero = 0
	empty =
	size = 10k
	bigger = 2M
	quoted = " leading and trailing "
	escapes = "line\n tab\t backspace\b quote\" slash\\"
	badescape = "\q"
	continued = first \
		second

[user]
	name = Firstname Lastname
