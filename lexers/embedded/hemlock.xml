<lexer>
  <config>
    <name>Hemlock</name>
    <alias>hemlock</alias>
    <alias>hml</alias>
    <filename>*.hml</filename>
    <mime_type>text/x-hemlock</mime_type>
    <ensure_nl>true</ensure_nl>
  </config>
  <rules>
    <state name="root">
      <rule pattern="\A#!.*\n">
        <token type="CommentHashbang"/>
      </rule>
      <rule pattern="\s+">
        <token type="TextWhitespace"/>
      </rule>
      <rule pattern="//[^\n]*">
        <token type="CommentSingle"/>
      </rule>
      <rule pattern="/\*">
        <token type="CommentMultiline"/>
        <push state="comment"/>
      </rule>
      <rule pattern="@(cold|const|flatten|hot|inline|noinline|optimize|pure|section|warn_unused)\b">
        <token type="NameDecorator"/>
      </rule>
      <rule pattern="@[a-zA-Z_]\w*">
        <token type="NameDecorator"/>
      </rule>
      <rule pattern="`">
        <token type="LiteralStringBacktick"/>
        <push state="tstring"/>
      </rule>
      <rule pattern="&#34;">
        <token type="LiteralString"/>
        <push state="dqstring"/>
      </rule>
      <rule pattern="&#39;(\\[nrt\\&#39;&#34;0]|\\x[0-9a-fA-F]{2}|\\u\{[0-9a-fA-F]{1,6}\}|[^&#39;\\])&#39;">
        <token type="LiteralStringChar"/>
      </rule>
      <rule pattern="0[xX][0-9a-fA-F][0-9a-fA-F_]*">
        <token type="LiteralNumberHex"/>
      </rule>
      <rule pattern="0[bB][01][01_]*">
        <token type="LiteralNumberBin"/>
      </rule>
      <rule pattern="0[oO][0-7][0-7_]*">
        <token type="LiteralNumberOct"/>
      </rule>
      <rule pattern="[0-9][0-9_]*\.[0-9_]*([eE][+\-]?[0-9]+)?">
        <token type="LiteralNumberFloat"/>
      </rule>
      <rule pattern="\.[0-9][0-9_]*([eE][+\-]?[0-9]+)?">
        <token type="LiteralNumberFloat"/>
      </rule>
      <rule pattern="[0-9][0-9_]*[eE][+\-]?[0-9]+">
        <token type="LiteralNumberFloat"/>
      </rule>
      <rule pattern="[0-9][0-9_]*">
        <token type="LiteralNumberInteger"/>
      </rule>
      <rule words="import export from as" prefix="\b" suffix="\b">
        <token type="KeywordNamespace"/>
      </rule>
      <rule words="let const define fn enum type extern ref gpu" prefix="\b" suffix="\b">
        <token type="KeywordDeclaration"/>
      </rule>
      <rule words="if else while for in loop match switch case default break continue return defer try catch finally throw async await" prefix="\b" suffix="\b">
        <token type="Keyword"/>
      </rule>
      <rule words="true false null" prefix="\b" suffix="\b">
        <token type="KeywordConstant"/>
      </rule>
      <rule pattern="\b(self)\b">
        <token type="NameBuiltinPseudo"/>
      </rule>
      <rule words="i8 i16 i32 i64 u8 u16 u32 u64 f32 f64 bool string rune array object ptr buffer void integer number byte file task channel gpu_buffer gpu_local Self" prefix="\b" suffix="\b">
        <token type="KeywordType"/>
      </rule>
      <rule words="print write eprint read_line typeof typeid alloc free realloc talloc memset memcpy sizeof panic assert apply exec exec_argv spawn spawn_with join detach select global_id local_array barrier ffi_sizeof buffer_ptr ptr_null ptr_offset ptr_to_buffer" prefix="\b" suffix="\b">
        <token type="NameBuiltin"/>
      </rule>
      <rule pattern="\b(ptr_(read|write|deref)_(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|ptr))\b">
        <token type="NameBuiltin"/>
      </rule>
      <rule pattern="\b(atomic_(load|store|add|sub|and|or|xor|cas|exchange)_(i32|i64)|atomic_fence)\b">
        <token type="NameBuiltin"/>
      </rule>
      <rule pattern="[a-zA-Z_]\w*(?=\s*\()">
        <token type="NameFunction"/>
      </rule>
      <rule pattern="\b[A-Z][A-Z0-9_]+\b">
        <token type="NameConstant"/>
      </rule>
      <rule pattern="\b[A-Z]\w*\b">
        <token type="NameClass"/>
      </rule>
      <rule pattern="[a-zA-Z_]\w*">
        <token type="Name"/>
      </rule>
      <rule pattern="\?\?=|&lt;&lt;=|&gt;&gt;=|\?\?|\?\.|=&gt;|\.\.\.|&amp;&amp;|\|\||\+\+|--|&lt;&lt;|&gt;&gt;|[+\-*/%&amp;|^!=&lt;&gt;]=|[+\-*/%&amp;|^~!&lt;&gt;=?]">
        <token type="Operator"/>
      </rule>
      <rule pattern="[{}()\[\];,.:]">
        <token type="Punctuation"/>
      </rule>
    </state>
    <state name="comment">
      <rule pattern="[^*/]+">
        <token type="CommentMultiline"/>
      </rule>
      <rule pattern="\*/">
        <token type="CommentMultiline"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="[*/]">
        <token type="CommentMultiline"/>
      </rule>
    </state>
    <state name="numeric_escapes">
      <rule pattern="\\x[0-9a-fA-F]{2}">
        <token type="LiteralStringEscape"/>
      </rule>
      <rule pattern="\\u\{[0-9a-fA-F]{1,6}\}">
        <token type="LiteralStringEscape"/>
      </rule>
    </state>
    <state name="dqstring">
      <rule pattern="&#34;">
        <token type="LiteralString"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="\\[nrt\\&#39;&#34;0]">
        <token type="LiteralStringEscape"/>
      </rule>
      <rule>
        <include state="numeric_escapes"/>
      </rule>
      <rule pattern="\\.">
        <token type="Error"/>
      </rule>
      <rule pattern="[^&#34;\\]+">
        <token type="LiteralString"/>
      </rule>
    </state>
    <state name="tstring">
      <rule pattern="`">
        <token type="LiteralStringBacktick"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="\$\{">
        <token type="LiteralStringInterpol"/>
        <push state="interp"/>
      </rule>
      <rule pattern="\\[nrt\\`$]">
        <token type="LiteralStringEscape"/>
      </rule>
      <rule>
        <include state="numeric_escapes"/>
      </rule>
      <rule pattern="\\.">
        <token type="Error"/>
      </rule>
      <rule pattern="\$(?!\{)">
        <token type="LiteralStringBacktick"/>
      </rule>
      <rule pattern="[^`\\$]+">
        <token type="LiteralStringBacktick"/>
      </rule>
    </state>
    <state name="interp">
      <rule pattern="\}">
        <token type="LiteralStringInterpol"/>
        <pop depth="1"/>
      </rule>
      <rule>
        <include state="root"/>
      </rule>
    </state>
  </rules>
</lexer>
