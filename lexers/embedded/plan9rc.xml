<lexer>
  <config>
    <name>Plan 9 rc</name>
    <alias>plan9rc</alias>
    <alias>rc</alias>
    <filename>*.rc</filename>
    <mime_type>text/x-plan9-rc</mime_type>
    <ensure_nl>true</ensure_nl>
    <analyse first="true">
      <regex pattern="(?m)^#!.*/bin/(?:env\s+)?rc\b" score="1.0"/>
    </analyse>
  </config>
  <rules>
    <state name="root">
      <rule pattern="\A#!.+\n">
        <token type="CommentHashbang"/>
      </rule>
      <rule pattern="#[^\n]*">
        <token type="CommentSingle"/>
      </rule>
      <rule pattern="\\\n">
        <token type="LiteralStringEscape"/>
      </rule>
      <rule pattern="\s+">
        <token type="Text"/>
      </rule>
      <rule pattern="&#39;(&#39;&#39;|[^&#39;])*&#39;">
        <token type="LiteralStringSingle"/>
      </rule>
      <rule pattern="`{">
        <token type="LiteralStringBacktick"/>
        <push state="command"/>
      </rule>
      <rule pattern="(&lt;|&gt;){">
        <token type="Operator"/>
        <push state="command"/>
      </rule>
      <rule pattern="(\$[#&#34;]?)([A-Za-z0-9_*][A-Za-z0-9_]*)">
        <bygroups>
          <token type="Operator"/>
          <token type="NameVariable"/>
        </bygroups>
      </rule>
      <rule pattern="\$[#&#34;]?(?=[`&#39;(&lt;&gt;])">
        <token type="Operator"/>
      </rule>
      <rule pattern="\$[#&#34;]?(?=\$)">
        <token type="Operator"/>
      </rule>
      <rule pattern="(\b[A-Za-z_*][A-Za-z0-9_]*)(\s*)(=)">
        <bygroups>
          <token type="NameVariable"/>
          <token type="Text"/>
          <token type="Operator"/>
        </bygroups>
      </rule>
      <rule pattern="\b(for|in|while|if|not|switch|fn|case)\b">
        <token type="Keyword"/>
      </rule>
      <rule pattern="(~|!|@)\b?">
        <token type="Keyword"/>
      </rule>
      <rule pattern="(?m)^(\s*)(\.)(?=\s|$)">
        <bygroups>
          <token type="Text"/>
          <token type="NameBuiltin"/>
        </bygroups>
      </rule>
      <rule pattern="([;&amp;|{}])(\s*)(\.)(?=\s|$)">
        <bygroups>
          <token type="Operator"/>
          <token type="Text"/>
          <token type="NameBuiltin"/>
        </bygroups>
      </rule>
      <rule pattern="(builtin|cd|eval|exec|flag|exit|rfork|shift|wait|whatis)(?=\s|[;&amp;|(){}]|$)">
        <token type="NameBuiltin"/>
      </rule>
      <rule pattern="(&gt;&gt;|&lt;&lt;|&lt;&gt;|&gt;|&lt;)(\[[^\]\n]*\])?">
        <bygroups>
          <token type="Operator"/>
          <token type="NameDecorator"/>
        </bygroups>
      </rule>
      <rule pattern="(\|)(\[[^\]\n]*\])?">
        <bygroups>
          <token type="Operator"/>
          <token type="NameDecorator"/>
        </bygroups>
      </rule>
      <rule pattern="&amp;&amp;|\|\||[;&amp;^=(){}]">
        <token type="Operator"/>
      </rule>
      <rule pattern="\d+">
        <token type="LiteralNumberInteger"/>
      </rule>
      <rule pattern="[^\s#;&amp;|^=$`&#39;{}()&lt;&gt;]+">
        <token type="Text"/>
      </rule>
      <rule pattern=".">
        <token type="Text"/>
      </rule>
    </state>
    <state name="command">
      <rule pattern="}">
        <token type="LiteralStringBacktick"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="{">
        <token type="Operator"/>
        <push state="command"/>
      </rule>
      <rule pattern="\A#!.+\n">
        <token type="CommentHashbang"/>
      </rule>
      <rule pattern="#[^\n]*">
        <token type="CommentSingle"/>
      </rule>
      <rule pattern="\\\n">
        <token type="LiteralStringEscape"/>
      </rule>
      <rule pattern="\s+">
        <token type="Text"/>
      </rule>
      <rule pattern="&#39;(&#39;&#39;|[^&#39;])*&#39;">
        <token type="LiteralStringSingle"/>
      </rule>
      <rule pattern="`{">
        <token type="LiteralStringBacktick"/>
        <push state="command"/>
      </rule>
      <rule pattern="(&lt;|&gt;){">
        <token type="Operator"/>
        <push state="command"/>
      </rule>
      <rule pattern="(\$[#&#34;]?)([A-Za-z0-9_*][A-Za-z0-9_]*)">
        <bygroups>
          <token type="Operator"/>
          <token type="NameVariable"/>
        </bygroups>
      </rule>
      <rule pattern="\$[#&#34;]?(?=[`&#39;(&lt;&gt;])">
        <token type="Operator"/>
      </rule>
      <rule pattern="\$[#&#34;]?(?=\$)">
        <token type="Operator"/>
      </rule>
      <rule pattern="(\b[A-Za-z_*][A-Za-z0-9_]*)(\s*)(=)">
        <bygroups>
          <token type="NameVariable"/>
          <token type="Text"/>
          <token type="Operator"/>
        </bygroups>
      </rule>
      <rule pattern="\b(for|in|while|if|not|switch|fn|case)\b">
        <token type="Keyword"/>
      </rule>
      <rule pattern="(~|!|@)\b?">
        <token type="Keyword"/>
      </rule>
      <rule pattern="(?m)^(\s*)(\.)(?=\s|$)">
        <bygroups>
          <token type="Text"/>
          <token type="NameBuiltin"/>
        </bygroups>
      </rule>
      <rule pattern="([;&amp;|{}])(\s*)(\.)(?=\s|$)">
        <bygroups>
          <token type="Operator"/>
          <token type="Text"/>
          <token type="NameBuiltin"/>
        </bygroups>
      </rule>
      <rule pattern="(builtin|cd|eval|exec|flag|exit|rfork|shift|wait|whatis)(?=\s|[;&amp;|(){}]|$)">
        <token type="NameBuiltin"/>
      </rule>
      <rule pattern="(&gt;&gt;|&lt;&lt;|&lt;&gt;|&gt;|&lt;)(\[[^\]\n]*\])?">
        <bygroups>
          <token type="Operator"/>
          <token type="NameDecorator"/>
        </bygroups>
      </rule>
      <rule pattern="(\|)(\[[^\]\n]*\])?">
        <bygroups>
          <token type="Operator"/>
          <token type="NameDecorator"/>
        </bygroups>
      </rule>
      <rule pattern="&amp;&amp;|\|\||[;&amp;^=(){}]">
        <token type="Operator"/>
      </rule>
      <rule pattern="\d+">
        <token type="LiteralNumberInteger"/>
      </rule>
      <rule pattern="[^\s#;&amp;|^=$`&#39;{}()&lt;&gt;]+">
        <token type="Text"/>
      </rule>
      <rule pattern=".">
        <token type="Text"/>
      </rule>
    </state>
  </rules>
</lexer>
