<lexer>
  <config>
    <name>Genshi HTML</name>
    <alias>html+genshi</alias>
    <alias>html+kid</alias>
    <mime_type>text/html+genshi</mime_type>
    <dot_all>true</dot_all>
    <not_multiline>true</not_multiline>
  </config>
  <rules>
    <state name="root">
      <rule pattern="[^&lt;$]+">
        <token type="Other"/>
      </rule>
      <rule pattern="(&lt;\?python)(.*?)(\?&gt;)">
        <bygroups>
          <token type="CommentPreproc"/>
          <using lexer="Python"/>
          <token type="CommentPreproc"/>
        </bygroups>
      </rule>
      <rule pattern="&lt;\s*(script|style)\s*.*?&gt;.*?&lt;\s*/\1\s*&gt;">
        <token type="Other"/>
      </rule>
      <rule pattern="&lt;\s*py:[a-zA-Z0-9]+">
        <token type="NameTag"/>
        <push state="pytag"/>
      </rule>
      <rule pattern="&lt;\s*[a-zA-Z0-9:.]+">
        <token type="NameTag"/>
        <push state="tag"/>
      </rule>
      <rule>
        <include state="variable"/>
      </rule>
      <rule pattern="[&lt;$]">
        <token type="Other"/>
      </rule>
    </state>
    <state name="pytag">
      <rule pattern="\s+">
        <token type="Text"/>
      </rule>
      <rule pattern="[\w:-]+\s*=">
        <token type="NameAttribute"/>
        <push state="pyattr"/>
      </rule>
      <rule pattern="/?\s*&gt;">
        <token type="NameTag"/>
        <pop depth="1"/>
      </rule>
    </state>
    <state name="pyattr">
      <rule pattern="(&#34;)(.*?)(&#34;)">
        <bygroups>
          <token type="LiteralString"/>
          <using lexer="Python"/>
          <token type="LiteralString"/>
        </bygroups>
        <pop depth="1"/>
      </rule>
      <rule pattern="(&#39;)(.*?)(&#39;)">
        <bygroups>
          <token type="LiteralString"/>
          <using lexer="Python"/>
          <token type="LiteralString"/>
        </bygroups>
        <pop depth="1"/>
      </rule>
      <rule pattern="[^\s&gt;]+">
        <token type="LiteralString"/>
        <pop depth="1"/>
      </rule>
    </state>
    <state name="tag">
      <rule pattern="\s+">
        <token type="Text"/>
      </rule>
      <rule pattern="py:[\w-]+\s*=">
        <token type="NameAttribute"/>
        <push state="pyattr"/>
      </rule>
      <rule pattern="[\w:-]+\s*=">
        <token type="NameAttribute"/>
        <push state="attr"/>
      </rule>
      <rule pattern="/?\s*&gt;">
        <token type="NameTag"/>
        <pop depth="1"/>
      </rule>
    </state>
    <state name="attr">
      <rule pattern="&#34;">
        <token type="LiteralString"/>
        <push state="attr-dstring"/>
      </rule>
      <rule pattern="&#39;">
        <token type="LiteralString"/>
        <push state="attr-sstring"/>
      </rule>
      <rule pattern="[^\s&gt;]*">
        <token type="LiteralString"/>
        <pop depth="1"/>
      </rule>
    </state>
    <state name="attr-dstring">
      <rule pattern="&#34;">
        <token type="LiteralString"/>
        <pop depth="1"/>
      </rule>
      <rule>
        <include state="strings"/>
      </rule>
      <rule pattern="&#39;">
        <token type="LiteralString"/>
      </rule>
    </state>
    <state name="attr-sstring">
      <rule pattern="&#39;">
        <token type="LiteralString"/>
        <pop depth="1"/>
      </rule>
      <rule>
        <include state="strings"/>
      </rule>
      <rule pattern="&#39;">
        <token type="LiteralString"/>
      </rule>
    </state>
    <state name="strings">
      <rule pattern="[^&#34;&#39;$]+">
        <token type="LiteralString"/>
      </rule>
      <rule>
        <include state="variable"/>
      </rule>
    </state>
    <state name="variable">
      <rule pattern="(?&lt;!\$)(\$\{)(.+?)(\})">
        <bygroups>
          <token type="CommentPreproc"/>
          <using lexer="Python"/>
          <token type="CommentPreproc"/>
        </bygroups>
      </rule>
      <rule pattern="(?&lt;!\$)(\$)([a-zA-Z_][\w\.]*)">
        <token type="NameVariable"/>
      </rule>
    </state>
  </rules>
</lexer>
