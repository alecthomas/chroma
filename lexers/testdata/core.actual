import core.collection.{Array, HashMap, HashSet, List, Queue}
import core.random.Random

@internal
fun unsafeKillRefs[T](arr: Array[T], idx: Int64): Unit

@private
fun isValidUtf8(data: Array[UInt8]): Bool {
  var i = 0

  while i < data.size {
    let by = data(i).toInt32
    var codepoint = 0i32
    var bytes = 0i32
    var min = 0i32
    var max = 0i32

    if by & 0x80i32 == 0i32 {
      bytes = 0
      i = i + 1
    } else {
      if by
      ... & 0xC0i32 == 0x80i32 {
        return false
      }
      ... & 0xE0i32 == 0xC0i32 {
        codepoint = by & 0x1Fi32
        bytes = 1
        min = 0x80
        max = 0x7FFi32
      }
      ... & 0xF0i32 == 0xE0i32 {
        codepoint = by & 0xFi32
        bytes = 2i32
        min = 0x800i32
        max = 0xFFFFi32
      }
      ... & 0xF8i32 == 0xF0i32 {
        codepoint = by & 0x7i32
        bytes = 3
        min = 0x10000
        max = 0x10FFFFi32
      }

      while bytes > 0i32 {
        bytes = bytes - 1i32
        i = i + 1

        if i >= data.size {
          return false
        }

        let by = data(i).toInt32

        if by & 0xC0i32 != 0x80i32 {
          return false
        }

        codepoint = codepoint.shiftUp(6i32) | (by & 0x3Fi32)
      }

      if codepoint < min || codepoint > max {
        return false
      }

      i = i + 1
    }
  }

  return true
}

class Stacktrace() {
  var backtrace: Option[Array[Int32]] = None[Array[Int32]];
  var elements: Option[Array[StacktraceElement]] = None[Array[StacktraceElement]];

  self.retrieveStacktrace();

  fun getStacktrace(): Array[StacktraceElement] {
    if self.elements.isSome {
      return self.elements.getOrPanic()
    }

    if self.backtrace.isNone {
      let elements = Array[StacktraceElement]()
      self.elements = Some[Array[StacktraceElement]](elements)
      return elements
    }

    let backtraceLength = self.backtrace.getOrPanic().size
    var i = 0
    let len = backtraceLength / 2
    let elements = List[StacktraceElement]()
    elements.reserve(len)

    while i < len {
      elements.push(self.getStacktraceElement(i))
      i = i + 1
    }

    let elements = elements.toArray()
    self.elements = Some(elements)
    return elements
  }

  fun printStacktrace(): Unit {
    let x = self.getStacktrace()
    var i = 0

    for frame in self.getStacktrace() {
      println(frame.toString())
    }
  }

  @internal fun retrieveStacktrace(): Unit
  @internal fun getStacktraceElement(idx: Int64): StacktraceElement
}

@private class StacktraceElement(@private let name: String, @private let line: Int32) {
  fun toString: String = "${self.name}: ${self.line}"
}

trait Default {
  @static fun default: Self
}

/* total order */
trait Sortable {
  fun sortsAs(other: Self): Int32
  // ideally we would be able to provide a default implementation for the next 3 methods based on `sortsAs`
  fun sortsBefore(other: Self): Bool
  fun sortsAfter(other: Self): Bool
  fun sortsSame(other: Self): Bool
}

union Option[T] with Some(T), None {

  fun isNone: Bool = if self
    ... is Some(_) { false }
    ... is None    { true  }

  fun isSome: Bool = if self
    ... is Some(_) { true  }
    ... is None    { false }

}

impl[T] Option[Option[T]] {
  // WTF -- removing `()` causes memory corruption in main (tests/stdlib/option-flatten.core:6) -- WTF
  fun flatten(): Option[T] = if self
    ... is Some(val) { val }
    ... is None      { None[T] }
}

union Result[T, E] with Pass(T), Fail(E) {

  fun isPass: Bool = if self
    ... is Pass(_) { true  }
    ... is Fail(_) { false }

  fun isFail: Bool = if self
    ... is Pass(_) { false }
    ... is Fail(_) { true  }

}

trait [T, E] Identity for Result[T, E] {
  fun identicalTo(rhs: Result[T, E]): Bool = self === rhs
}

impl[T: Identity, E] Result[T, E] {
  fun includes(rhs: T): Bool = if self
    ... is Pass(val) { val.identicalTo(rhs) }
    ... is Fail(_)   { false }
}

class List[T](values: T...) {
  @private var array: Array[T] = values;
  @private var len: Int64 = values.size();

  @static fun ofCapacity(capacity: Int64): List[T] = {
    let list = List[T]()
    list.reserve(capacity)
    return list // without "return", it fails with: assertion failed: self.used(src)
  }
}
