{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":semanticCommits",
		":semanticCommitTypeAll(chore)",
		":semanticCommitScope(deps)",
		"group:allNonMajor",
		"schedule:earlyMondays", // Run once a week.
		'helpers:pinGitHubActionDigests',
	],
	"postUpdateOptions": ["gomodTidy"],
	"packageRules": [
		{
			"matchPackageNames": ["golangci-lint"],
			"matchManagers": ["hermit"],
			"enabled": false
		},
		{
			"matchPackageNames": ["github.com/gorilla/csrf"],
			"matchManagers": ["gomod"],
			"enabled": false
		},
		{
			// The cmd modules replace chroma with the checkout, so its version is a placeholder.
			"matchPackageNames": ["github.com/alecthomas/chroma/v3"],
			"matchManagers": ["gomod"],
			"enabled": false
		}
	]
}
