// Комментарий: разбор товаров
Процедура ОбработкаПроведения() Экспорт
	СпрТ = СоздатьОбъект("Справочник.Товары");
	Дата = '20240101';
	Пока СпрТ.ПолучитьЭлемент() = 1 Цикл
		Если СпрТ.ЭтоГруппа() = 0 Тогда
			Сообщить("Код " + Строка(СпрТ.Код) + " ставка " + Строка(20.5));
		ИначеЕсли Не Истина Тогда
			Перейти ~Конец;
		КонецЕсли;
	КонецЦикла;
	For Each Стр In Список Do
		Стр.Сумма = Стр.Цена * Стр.Количество;
	EndDo;
~Конец:
	Возврат;
КонецПроцедуры
