# syntax=docker/dockerfile:1
FROM alpine:3.19 AS build
WORKDIR /app
COPY . .
ENV FOO=bar
ARG VERSION=1.0
RUN echo hi && \
    echo bye
EXPOSE 8080
HEALTHCHECK --interval=5m CMD curl -f http://localhost/ || exit 1
CMD ["/app/run"]
ARG GO=1.24
FROM golang:${GO} AS builder
LABEL org.opencontainers.image.title="app" version=2 \
      maintainer='someone'
ENV PATH="/app/bin:$PATH" MODE=prod
ENV A=1 B=2.0.1
