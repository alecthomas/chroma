<lexer>
  <config>
    <name>Git Config</name>
    <alias>gitconfig</alias>
    <alias>git-config</alias>
    <filename>.gitconfig</filename>
    <filename>.gitmodules</filename>
    <filename>gitconfig</filename>
    <filename>config.worktree</filename>
    <mime_type>text/x-git-config</mime_type>
  </config>
  <rules>
    <state name="root">
      <rule pattern="^([ \t]*)([;#].*)">
        <bygroups>
          <token type="Text"/>
          <token type="CommentSingle"/>
        </bygroups>
      </rule>
      <rule pattern="^([ \t]*)(\[)([A-Za-z0-9.-]+)([ \t]+)(&quot;(?:\\[^\n]|[^&quot;\n])*&quot;)(\])([ \t]+)([A-Za-z][A-Za-z0-9-]*)([ \t]*)(=)([ \t]*)">
        <bygroups>
          <token type="Text"/>
          <token type="Punctuation"/>
          <token type="Keyword"/>
          <token type="Text"/>
          <token type="LiteralStringDouble"/>
          <token type="Punctuation"/>
          <token type="Text"/>
          <token type="NameAttribute"/>
          <token type="Text"/>
          <token type="Operator"/>
          <token type="Text"/>
        </bygroups>
        <push state="value"/>
      </rule>
      <rule pattern="^([ \t]*)(\[)([A-Za-z0-9.-]+)(\])([ \t]+)([A-Za-z][A-Za-z0-9-]*)([ \t]*)(=)([ \t]*)">
        <bygroups>
          <token type="Text"/>
          <token type="Punctuation"/>
          <token type="Keyword"/>
          <token type="Punctuation"/>
          <token type="Text"/>
          <token type="NameAttribute"/>
          <token type="Text"/>
          <token type="Operator"/>
          <token type="Text"/>
        </bygroups>
        <push state="value"/>
      </rule>
      <rule pattern="^([ \t]*)(\[)([A-Za-z0-9.-]+)([ \t]+)(&quot;(?:\\[^\n]|[^&quot;\n])*&quot;)(\])([ \t]+)([A-Za-z][A-Za-z0-9-]*)([ \t]*)([;#].*)?$">
        <bygroups>
          <token type="Text"/>
          <token type="Punctuation"/>
          <token type="Keyword"/>
          <token type="Text"/>
          <token type="LiteralStringDouble"/>
          <token type="Punctuation"/>
          <token type="Text"/>
          <token type="NameAttribute"/>
          <token type="Text"/>
          <token type="CommentSingle"/>
        </bygroups>
      </rule>
      <rule pattern="^([ \t]*)(\[)([A-Za-z0-9.-]+)(\])([ \t]+)([A-Za-z][A-Za-z0-9-]*)([ \t]*)([;#].*)?$">
        <bygroups>
          <token type="Text"/>
          <token type="Punctuation"/>
          <token type="Keyword"/>
          <token type="Punctuation"/>
          <token type="Text"/>
          <token type="NameAttribute"/>
          <token type="Text"/>
          <token type="CommentSingle"/>
        </bygroups>
      </rule>
      <rule pattern="^([ \t]*)(\[)([A-Za-z0-9.-]+)([ \t]+)(&quot;(?:\\[^\n]|[^&quot;\n])*&quot;)(\])([ \t]*)([;#].*)?$">
        <bygroups>
          <token type="Text"/>
          <token type="Punctuation"/>
          <token type="Keyword"/>
          <token type="Text"/>
          <token type="LiteralStringDouble"/>
          <token type="Punctuation"/>
          <token type="Text"/>
          <token type="CommentSingle"/>
        </bygroups>
      </rule>
      <rule pattern="^([ \t]*)(\[)([A-Za-z0-9.-]+)(\])([ \t]*)([;#].*)?$">
        <bygroups>
          <token type="Text"/>
          <token type="Punctuation"/>
          <token type="Keyword"/>
          <token type="Punctuation"/>
          <token type="Text"/>
          <token type="CommentSingle"/>
        </bygroups>
      </rule>
      <rule pattern="^([ \t]*)([A-Za-z][A-Za-z0-9-]*)([ \t]*)(=)([ \t]*)">
        <bygroups>
          <token type="Text"/>
          <token type="NameAttribute"/>
          <token type="Text"/>
          <token type="Operator"/>
          <token type="Text"/>
        </bygroups>
        <push state="value"/>
      </rule>
      <rule pattern="^([ \t]*)([A-Za-z][A-Za-z0-9-]*)([ \t]*)([;#].*)?$">
        <bygroups>
          <token type="Text"/>
          <token type="NameAttribute"/>
          <token type="Text"/>
          <token type="CommentSingle"/>
        </bygroups>
      </rule>
      <rule pattern="[ \t]+|\n">
        <token type="Text"/>
      </rule>
      <rule pattern=".+">
        <token type="Text"/>
      </rule>
    </state>
    <state name="value">
      <rule pattern="\\\n">
        <token type="Text"/>
      </rule>
      <rule pattern="\n">
        <token type="Text"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="&quot;">
        <token type="LiteralStringDouble"/>
        <push state="string"/>
      </rule>
      <rule pattern="[;#].*$">
        <token type="CommentSingle"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="[^\\&quot;;#\n]+">
        <token type="LiteralString"/>
      </rule>
      <rule pattern="\\.">
        <token type="LiteralString"/>
      </rule>
      <rule pattern=".">
        <token type="Text"/>
      </rule>
    </state>
    <state name="string">
      <rule pattern="\\\n">
        <token type="Text"/>
      </rule>
      <rule pattern="\\[ntb&quot;\\]">
        <token type="LiteralStringEscape"/>
      </rule>
      <rule pattern="\\.">
        <token type="Error"/>
      </rule>
      <rule pattern="&quot;">
        <token type="LiteralStringDouble"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="[^\\&quot;\n]+">
        <token type="LiteralStringDouble"/>
      </rule>
      <rule pattern="\n">
        <token type="Text"/>
        <pop depth="1"/>
      </rule>
    </state>
  </rules>
</lexer>
